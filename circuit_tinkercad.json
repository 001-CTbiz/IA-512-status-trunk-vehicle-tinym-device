  "wiring_instructions": [
    "1. Conecte VCC do VL53L0X ao pino 3.3V da Lilygo T-PicoC3",
    "2. Conecte GND do VL53L0X ao pino GND da Lilygo T-PicoC3", 
    "3. Conecte SDA do VL53L0X ao pino GP12 da Lilygo T-PicoC3",
    "4. Conecte SCL do VL53L0X ao pino GP13 da Lilygo T-PicoC3",
    "5. Alimente o sistema via USB ou fonte externa 3.3V"
  ],
