{
  "version": "1.0.0",
  "metadata": {
    "title": "Sistema de Monitoramento do Baú - Lilygo T-PicoC3 + VL53L0X",
    "description": "Circuito para monitoramento do estado do baú de veículos usando sensor de distância VL53L0X e display LCD integrado",
    "author": "Sistema TinyML",
    "created": "2024-09-27",
    "tags": ["TinyML", "VL53L0X", "Lilygo", "RP2040", "I2C", "Display"]
  },
  "components": [
    {
      "id": "lilygo_t_picoc3",
      "type": "microcontroller",
      "name": "Lilygo T-PicoC3 Pi RP2040 LCD",
      "position": {"x": 0, "y": 0},
      "properties": {
        "voltage": "3.3V",
        "cpu": "RP2040",
        "frequency": "133MHz",
        "flash": "2MB",
        "ram": "256KB",
        "display": "TFT 240x135 pixels integrado"
      },
      "pins": {
        "power": {
          "3.3V": {"x": -50, "y": -30},
          "GND": {"x": -50, "y": -20}
        },
        "gpio": {
          "GP12": {"x": 50, "y": -10, "function": "I2C_SDA"},
          "GP13": {"x": 50, "y": 0, "function": "I2C_SCL"}
        }
      }
    },
    {
      "id": "vl53l0x_sensor",
      "type": "sensor",
      "name": "VL53L0X Time-of-Flight Sensor",
      "position": {"x": 200, "y": 0},
      "properties": {
        "type": "Time-of-Flight (ToF)",
        "range": "0-2000mm",
        "accuracy": "±3%",
        "interface": "I2C",
        "voltage": "3.3V",
        "current": "20mA"
      },
      "pins": {
        "VCC": {"x": 150, "y": -30},
        "GND": {"x": 150, "y": -20},
        "SDA": {"x": 150, "y": -10},
        "SCL": {"x": 150, "y": 0}
      }
    },
    {
      "id": "power_supply",
      "type": "power",
      "name": "Fonte de Alimentação 3.3V",
      "position": {"x": -100, "y": -50},
      "properties": {
        "voltage": "3.3V",
        "current": "500mA",
        "type": "USB ou Bateria"
      }
    }
  ],
  "connections": [
    {
      "from": {"component": "power_supply", "pin": "3.3V"},
      "to": {"component": "lilygo_t_picoc3", "pin": "3.3V"},
      "wire": {"color": "red", "thickness": 2}
    },
    {
      "from": {"component": "power_supply", "pin": "GND"},
      "to": {"component": "lilygo_t_picoc3", "pin": "GND"},
      "wire": {"color": "black", "thickness": 2}
    },
    {
      "from": {"component": "lilygo_t_picoc3", "pin": "3.3V"},
      "to": {"component": "vl53l0x_sensor", "pin": "VCC"},
      "wire": {"color": "red", "thickness": 1}
    },
    {
      "from": {"component": "lilygo_t_picoc3", "pin": "GND"},
      "to": {"component": "vl53l0x_sensor", "pin": "GND"},
      "wire": {"color": "black", "thickness": 1}
    },
    {
      "from": {"component": "lilygo_t_picoc3", "pin": "GP12"},
      "to": {"component": "vl53l0x_sensor", "pin": "SDA"},
      "wire": {"color": "blue", "thickness": 1}
    },
    {
      "from": {"component": "lilygo_t_picoc3", "pin": "GP13"},
      "to": {"component": "vl53l0x_sensor", "pin": "SCL"},
      "wire": {"color": "green", "thickness": 1}
    }
  ],
